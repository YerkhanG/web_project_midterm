{
  "info": {
    "name": "Game Scores API",
    "description": "Run the requests from top to bottom (Collection Runner works too). Create saves the new id in the variable scoreId; the next requests use it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "scoreId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. List scores",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Body is a list\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/scores/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            ""
          ]
        }
      }
    },
    {
      "name": "2. Create score",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Points saved\", function () { pm.expect(pm.response.json().points).to.eql(9500); });",
              "pm.collectionVariables.set(\"scoreId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scores/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player\": \"Nova\",\n  \"game\": \"Tetris\",\n  \"points\": 9500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Get score by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Player is Nova\", function () { pm.expect(pm.response.json().player).to.eql(\"Nova\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/scores/{{scoreId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            "{{scoreId}}",
            ""
          ]
        }
      }
    },
    {
      "name": "4. Update score (PUT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Points updated\", function () { pm.expect(pm.response.json().points).to.eql(15000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scores/{{scoreId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            "{{scoreId}}",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"player\": \"Nova\",\n  \"game\": \"Tetris\",\n  \"points\": 15000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Update one field (PATCH)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Points updated\", function () { pm.expect(pm.response.json().points).to.eql(20000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scores/{{scoreId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            "{{scoreId}}",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"points\": 20000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Delete score",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/scores/{{scoreId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            "{{scoreId}}",
            ""
          ]
        }
      }
    },
    {
      "name": "7. Get deleted score (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/scores/{{scoreId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scores",
            "{{scoreId}}",
            ""
          ]
        }
      }
    }
  ]
}
